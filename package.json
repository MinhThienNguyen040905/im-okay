{
  "name": "im-okay",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:contact-web": "npm --prefix apps/contact-web run start",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "supabase:reset": "supabase db reset --local",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop --no-backup",
    "test": "turbo run test && node --test supabase/functions/tests/*.test.mjs",
    "test:db": "supabase test db",
    "test:integration": "supabase db reset --local && supabase test db && node scripts/supabase-smoke.mjs",
    "typecheck": "turbo run typecheck && tsc -p supabase/functions/tsconfig.json"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "supabase": "2.111.0",
    "typescript": "~6.0.3",
    "turbo": "2.10.8"
  }
}
