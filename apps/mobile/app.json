{
  "expo": {
    "name": "I'm Okay",
    "slug": "im-okay",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "imokay",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7FAF9",
    "icon": "./assets/im-okay-app-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.imokay.app"
    },
    "android": {
      "package": "com.imokay.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/im-okay-app-icon.png",
        "backgroundColor": "#0F766E"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "safety-reminders"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép I'm Okay lấy vị trí hiện tại khi bạn chủ động chọn chia sẻ cùng SOS hoặc check-in."
        }
      ],
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ea9c673-0f86-4d5e-a802-53899da19dcb"
      }
    },
    "owner": "minh004"
  }
}
