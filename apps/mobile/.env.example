# Public values are embedded in the app bundle. Never place secrets here.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_DATA_MODE=fixture
# Supabase local Edge Function router; ignored while DATA_MODE=fixture.
EXPO_PUBLIC_API_URL=http://127.0.0.1:54321/functions/v1/api
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SENTRY_DSN=
